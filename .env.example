# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# RESEND_API_KEY: Optional. Set to dispatch real transactional onboarding emails via Resend API.
# When unset, CampusPulse logs and previews dispatched student credential emails in-app.
RESEND_API_KEY=""

# EMAIL_FROM: Optional sender address for Resend transactional onboarding emails.
EMAIL_FROM="CampusPulse <onboarding@campuspulse.edu>"
